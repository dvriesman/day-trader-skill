{
  "permissions": {
    "deny": [
      "mcp__alpaca__place_stock_order",
      "mcp__alpaca__place_option_order",
      "mcp__alpaca__place_crypto_order",
      "mcp__alpaca__close_position",
      "mcp__alpaca__close_all_positions",
      "mcp__alpaca__cancel_all_orders",
      "mcp__alpaca__replace_order_by_id"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*|Bash",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/order_guard.py\" pre", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/hooks/order_guard.py\" post", "timeout": 10}
        ]
      }
    ]
  }
}
